{
  "name": "lapunya-grooming",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20 <23",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "bot": "tsx src/bot/index.ts",
    "bot:watch": "tsx watch src/bot/index.ts",
    "reminders": "tsx src/jobs/reminders.ts",
    "webhook:set": "tsx scripts/set-webhook.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "grammy": "^1.36.1",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "@types/react": "^19.0.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
