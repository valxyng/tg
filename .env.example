# Required in every environment. Obtain from your PostgreSQL provider.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Required for the real Telegram bot. Obtain it from @BotFather; never commit it.
TELEGRAM_BOT_TOKEN=""
# A random 32+ character string; used by Telegram to sign webhook requests.
TELEGRAM_WEBHOOK_SECRET=""
# Public HTTPS base URL used only to install the Telegram webhook, without a trailing slash.
WEBHOOK_URL="https://your-project.up.railway.app"
# Secret that protects the scheduled reminders endpoint.
CRON_SECRET=""
# Required: numeric Telegram ID of the only Telegram administrator, from @userinfobot.
ADMIN_TELEGRAM_ID=""
# Optional additional administrators, separated by commas. Each ID is verified server-side.
ADMIN_TELEGRAM_IDS=""
# Development-only: set true only if you explicitly want demonstration service/master data.
SEED_DEMO_DATA="false"
